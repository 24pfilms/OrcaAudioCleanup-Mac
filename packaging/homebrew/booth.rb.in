# Homebrew cask for Booth. app/scripts/release.sh fills in the @…@ values and writes the result to
# dist/booth.rb; with --publish it commits that as Casks/booth.rb to the tap (BOOTH_TAP), so:
#   brew install --cask shrimbly/booth/booth
cask "orcaaudiocleanup" do
  version "@VERSION@"
  sha256 "@SHA256@"

  url "https://github.com/@REPOSITORY@/releases/download/v#{version}/OrcaAudioCleanup-#{version}.dmg"
  name "OrcaAudioCleanup"
  desc "Studio-quality voice for your recordings, enhanced locally"
  homepage "@HOMEPAGE@"

  livecheck do
    url :url
    strategy :github_latest
  end

  depends_on arch: :arm64
  depends_on formula: "ffmpeg"
  depends_on macos: :sonoma

  app "OrcaAudioCleanup.app"
  binary "#{appdir}/OrcaAudioCleanup.app/Contents/Resources/bin/booth"

  uninstall quit: "com.squarecirclelabs.OrcaAudioCleanup"

  zap trash: [
    "~/.cache/booth",
    "~/Library/Application Support/OrcaAudioCleanup",
    "~/Library/Caches/OrcaAudioCleanup",
    "~/Library/Logs/OrcaAudioCleanup",
    "~/Library/Preferences/com.squarecirclelabs.OrcaAudioCleanup.plist",
  ]
end
