# Read by app/scripts/release.sh; the environment wins over these.
#
# BOOTH_REPOSITORY: owner/name of the GitHub repository whose Releases host the disk image. Planned name;
#   change it here and in app/Sources/BoothCore/UpdateCheck.swift if the repo gets another. Releases are built unsigned by
#   .github/workflows/release.yml, which publishes without release.sh --publish.
# BOOTH_HOMEPAGE: the website.
# BOOTH_TAP: owner/name of a Homebrew tap. None: OrcaAudioCleanup has no cask.
BOOTH_REPOSITORY=24pfilms/OrcaAudioCleanup-Mac
BOOTH_HOMEPAGE=https://squarecirclelabs.com/
BOOTH_TAP=
